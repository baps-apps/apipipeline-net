{
  "Logging": { "LogLevel": { "Default": "Warning", "ApiPipeline.NET": "Information" } },
  "ApiPipeline": {
    "ForwardedHeaders": { "KnownNetworks": [ "10.0.0.0/8" ], "ClearDefaultProxies": true },
    "Cors": { "Enabled": true, "AllowedOrigins": [ "https://app.example.com" ] },
    "RequestTimeouts": { "Enabled": true, "DefaultTimeout": "00:00:30" },
    "EdgeRateLimiting": { "Enabled": true, "PermitLimit": 1000, "Window": "00:01:00" },
    "RateLimiting": {
      "Enabled": true,
      "DefaultPolicy": "standard",
      "AnonymousFallback": "RateLimit",
      "Policies": [
        { "Name": "standard", "Kind": "FixedWindow", "PermitLimit": 1000, "Window": "00:01:00" },
        { "Name": "smoke", "Kind": "FixedWindow", "PermitLimit": 2, "Window": "00:01:00" }
      ],
      "Redis": { "Enabled": false, "CommandTimeout": "00:00:02" }
    },
    "ResponseCompression": { "Enabled": true },
    "ResponseCaching": { "Enabled": true },
    "VersionDeprecation": {
      "Enabled": true,
      "DeprecatedVersions": [
        {
          "Version": "1.0",
          "DeprecationDate": "2026-01-01T00:00:00Z",
          "SunsetDate": "2027-01-01T00:00:00Z",
          "DeprecationLink": "https://docs.example.com/v1-deprecation",
          "SunsetLink": "https://docs.example.com/v1-sunset"
        }
      ]
    }
  }
}
