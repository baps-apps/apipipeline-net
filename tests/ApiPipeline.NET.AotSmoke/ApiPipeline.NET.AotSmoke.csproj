<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Publishes every ApiPipeline.NET package into one Native AOT app (CI: the "Native AOT" job, or
    scripts/aot-smoke.sh), so the packages' IsAotCompatible claim is checked against what the
    trimmer and ILC actually see, dependencies included (Asp.Versioning, StackExchange.Redis).
    TreatWarningsAsErrors (Directory.Build.props) turns every IL2xxx/IL3xxx warning into a failure;
    TrimmerSingleWarn=false reports each one rather than one per assembly.

    Not in the solution: it only needs building when published for AOT.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exercises the obsolete response caching feature on purpose, until it is removed. -->
    <NoWarn>$(NoWarn);APIPIPELINE001</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The ILCompiler packs come with the pinned SDK (global.json) and differ per runtime, so a
         lock file would need one section per RID; the referenced projects keep theirs. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ApiPipeline.NET\ApiPipeline.NET.csproj" />
    <ProjectReference Include="..\..\src\ApiPipeline.NET.Versioning\ApiPipeline.NET.Versioning.csproj" />
    <ProjectReference Include="..\..\src\ApiPipeline.NET.RateLimiting.Redis\ApiPipeline.NET.RateLimiting.Redis.csproj" />
  </ItemGroup>
</Project>
