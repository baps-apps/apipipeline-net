<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive dependencies resolve to the versions pinned here too, so one package has one
         version across the whole graph. Asp.Versioning.Mvc 10.2.1 (its latest) depends on
         Asp.Versioning.Http >= 10.2.1; this makes every project, the sample's MVC path included,
         resolve the 10.2.3 pinned below rather than whatever each path asks for. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <!-- No 10.2.3 exists; transitive pinning (above) aligns its Asp.Versioning.Http dependency. -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CodeStyle.NET" Version="2.0.0" />
    <!-- Exact pin, keep the brackets: FluentAssertions 8+ is commercially licensed (Xceed). -->
    <PackageVersion Include="FluentAssertions" Version="[7.1.0]" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <!-- FakeTimeProvider: tests drive timeouts, cooldowns and timers instead of waiting on the clock. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <!-- The version Caching.NET uses, so an API that installs both resolves one version. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <!-- Real Redis for the ApiPipeline.NET.RateLimiting.Redis tests (Docker). -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <!-- xUnit v3 (v2 is in maintenance mode) on Microsoft.Testing.Platform, which global.json makes
         the dotnet test runner. VSTest (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) is not
         used: MTP v2 refuses VSTest mode on the .NET 10 SDK. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Coverage (cobertura) and TRX reports, as MTP extensions. TrxReport matches the
         Microsoft.Testing.Platform version xunit.v3 4.0.2 references. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
  </ItemGroup>
</Project>
