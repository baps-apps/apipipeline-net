<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared\Shared.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and Native AOT analyzers on: a base package for every API must not block AOT.
         Configuration binding and options validation are source-generated (no reflection). -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>ApiPipeline.NET</PackageId>
    <Description>Shared ASP.NET Core API pipeline (rate limiting, compression, caching, security headers, CORS, correlation ID, request limits).</Description>
    <PackageTags>aspnetcore;api;pipeline;middleware;ratelimiting;compression;caching;security-headers;cors;correlation-id;api-versioning;kestrel;request-limits;forwarded-headers;observability</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Microsoft.NET.Sdk.Web supplies these as implicit usings; this is a library, so it targets
       Microsoft.NET.Sdk and declares the same set explicitly. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CodeStyle.NET" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>