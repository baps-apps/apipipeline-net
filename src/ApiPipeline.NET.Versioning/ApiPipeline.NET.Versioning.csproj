<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Shared\Shared.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trimming and Native AOT analyzers on: a base package for every API must not block AOT.
         Configuration binding and options validation are source-generated (no reflection). -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>ApiPipeline.NET.Versioning</PackageId>
    <!-- Already released, so package validation compares the public API against the shared
         baseline (ApiCompatBaselineVersion in Directory.Build.targets). Intended breaks are listed
         in CompatibilitySuppressions.xml. -->
    <Description>Configuration-driven API version deprecation and sunset policies for ApiPipeline.NET, built on Asp.Versioning.</Description>
    <PackageTags>aspnetcore;api;pipeline;versioning;deprecation;sunset;asp-versioning</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared helpers this package does not use: duration and enum option checks. -->
    <Compile Remove="..\Shared\DurationSettings.cs;..\Shared\EnumValue.cs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="CodeStyle.NET" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>