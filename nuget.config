<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Public NuGet -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- BAPS Apps GitHub Packages -->
    <add key="baps-apps-packages" value="https://nuget.pkg.github.com/baps-apps/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- BAPS Apps GitHub Packages used for current project -->
    <packageSource key="baps-apps-packages">
      <package pattern="CodeStyle.NET" />
      <package pattern="OpenTelemetry.NET" />
      <!-- The API-compatibility baselines (Directory.Build.targets): package validation restores the
           last published version of each package to compare its public API against. Both patterns
           are needed: "ApiPipeline.NET.*" does not match the core ID itself. Without them, the
           satellite baselines would resolve from nuget.org, where anyone can claim the ID. -->
      <package pattern="ApiPipeline.NET" />
      <package pattern="ApiPipeline.NET.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>