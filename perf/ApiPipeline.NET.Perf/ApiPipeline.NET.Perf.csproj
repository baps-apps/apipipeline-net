<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Exercises the obsolete response caching feature on purpose, until it is removed. -->
    <NoWarn>$(NoWarn);APIPIPELINE001</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PerformanceImages.cs" Link="PerformanceImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApiPipeline.NET\ApiPipeline.NET.csproj" />
    <ProjectReference Include="..\..\src\ApiPipeline.NET.RateLimiting.Redis\ApiPipeline.NET.RateLimiting.Redis.csproj" />
    <ProjectReference Include="..\..\src\ApiPipeline.NET.Versioning\ApiPipeline.NET.Versioning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>
</Project>
