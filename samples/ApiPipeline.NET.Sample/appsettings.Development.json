{
  "ApiPipeline": {
    "RateLimiting": {
      "Enabled": true,
      "AnonymousFallback": "Reject",
      "DefaultPolicy": "permissive",
      "Policies": [
        {
          "Name": "strict",
          "Kind": "FixedWindow",
          "PermitLimit": 20,
          "Window": "00:01:00",
          "QueueLimit": 0,
          "QueueProcessingOrder": "OldestFirst"
        },
        {
          "Name": "permissive",
          "Kind": "FixedWindow",
          "PermitLimit": 200,
          "Window": "00:01:00",
          "QueueLimit": 0,
          "QueueProcessingOrder": "OldestFirst"
        }
      ]
    },
    "ResponseCompression": {
      "Enabled": true,
      "EnableForHttps": true,
      "EnableBrotli": true,
      "EnableGzip": true,
      "MimeTypes": [
        "application/json",
        "application/problem+json"
      ],
      "ExcludedMimeTypes": [],
      "ExcludedPaths": [
        "/health"
      ]
    },
    "OutputCaching": {
      "Enabled": true,
      "DefaultExpiration": "00:01:00",
      "SizeLimitBytes": 52428800,
      "UseCaseSensitivePaths": false
    },
    "SecurityHeaders": {
      "Enabled": true,
      "ReferrerPolicy": "no-referrer",
      "AddXContentTypeOptionsNoSniff": true,
      "EnableStrictTransportSecurity": false
    },
    "Cors": {
      "Enabled": true,
      "AllowAllInDevelopment": true,
      "AllowedOrigins": [],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "AllowedHeaders": [
        "Content-Type",
        "Authorization",
        "X-Correlation-Id"
      ],
      "AllowCredentials": false
    },
    "VersionDeprecation": {
      "Enabled": true,
      "DeprecatedVersions": [
        {
          "Version": "1.0",
          "DeprecationDate": "2025-01-01T00:00:00Z",
          "SunsetDate": "2028-06-30T00:00:00Z",
          "DeprecationLink": "https://example.com/api/v1-migration",
          "SunsetLink": "https://example.com/api/v1-sunset"
        }
      ]
    },
    "RequestLimits": {
      "SuppressServerHeader": true,
      "Enabled": true,
      "MaxRequestBodySize": 26214400,
      "MaxRequestHeadersTotalSize": 16384,
      "MaxRequestHeaderCount": 100,
      "MaxFormValueCount": 1024
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "ForwardLimit": 1,
      "ClearDefaultProxies": false
    }
  }
}
