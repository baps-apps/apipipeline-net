<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only the sources below, so a machine-wide source cannot serve these packages. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="baps-apps-packages" value="https://nuget.pkg.github.com/baps-apps/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Internal packages come only from the private feed, never from nuget.org, where anyone can
         publish a package under the same ID. "ApiPipeline.NET.*" does not match the core ID. -->
    <packageSource key="baps-apps-packages">
      <package pattern="ApiPipeline.NET" />
      <package pattern="ApiPipeline.NET.*" />
      <package pattern="CodeStyle.NET" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
